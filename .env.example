# ==============================================================================
# DIGINU DEPLOYMENT CONFIGURATION TEMPLATE (PER RESTAURANT)
# ==============================================================================
# DigiNu is architected for independent, single-tenant deployments per restaurant.
# Copy this file to .env.local for local development or configure these variables
# directly in your cloud hosting provider (Railway, Render, VPS/Coolify).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Dedicated PostgreSQL)
# ------------------------------------------------------------------------------
# Dedicated PostgreSQL pooled connection string for runtime queries.
# Example: postgresql://postgres:password@ep-sample-123.us-east-2.aws.neon.tech/diginu_db?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/diginu_client_db?sslmode=require"

# Direct PostgreSQL connection string for Prisma migrations (bypassing connection poolers).
# Example: postgresql://postgres:password@ep-sample-123.us-east-2.aws.neon.tech/diginu_db?sslmode=require
DIRECT_URL="postgresql://user:password@host:5432/diginu_client_db?sslmode=require"

# ------------------------------------------------------------------------------
# 2. APPLICATION RUNTIME & DOMAIN
# ------------------------------------------------------------------------------
# Node runtime environment ('development', 'production', or 'test')
NODE_ENV="production"

# The restaurant's public canonical URL (used for QR code encoding and absolute links)
# Example: https://bella-italia.com or https://diginu-bella-italia.up.railway.app
NEXT_PUBLIC_APP_URL="https://bella-italia.com"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (NextAuth.js / Auth.js v5)
# ------------------------------------------------------------------------------
# Cryptographic secret for signing session cookies and JWTs.
# Generate in terminal using: openssl rand -base64 32
AUTH_SECRET="your-32-byte-base64-auth-secret-here"

# Set to "true" when running behind reverse proxies (PaaS, Coolify, Traefik)
AUTH_TRUST_HOST="true"

# ------------------------------------------------------------------------------
# 4. RESTAURANT INITIAL SEED CONFIGURATION (Used by prisma/seed.ts)
# ------------------------------------------------------------------------------
# Display name of the restaurant for branding and header metadata
RESTAURANT_NAME="Bella Italia"

# URL-safe alphanumeric slug used for identifiers and asset naming
RESTAURANT_SLUG="bella-italia"

# Initial admin email address for owner dashboard login
INITIAL_OWNER_EMAIL="owner@bella-italia.com"

# Temporary initial password for first login (Owner must be prompted to change upon onboarding)
INITIAL_OWNER_PASSWORD="TemporarySecurePassword123!"

# ------------------------------------------------------------------------------
# 5. IMAGEKIT.IO INTEGRATION (Media Storage & Delivery CDN)
# ------------------------------------------------------------------------------
# Public API key for client-side upload SDK initialization
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="public_sample_key_here"

# Private API key for server-side HMAC signature generation and asset deletion (KEEP SECRET)
IMAGEKIT_PRIVATE_KEY="private_sample_key_here"

# ImageKit endpoint URL for dynamic image CDN delivery
# Example: https://ik.imagekit.io/your_imagekit_id
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/diginu"

# Dedicated folder prefix in ImageKit media library to enforce strict isolation per restaurant
IMAGEKIT_FOLDER_PREFIX="bella-italia"

# ------------------------------------------------------------------------------
# 6. CLOUDFLARE WORKERS AI (Neural Food Image Generation)
# ------------------------------------------------------------------------------
# Cloudflare account ID from the Cloudflare Dashboard overview
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id_here"

# Cloudflare API token with 'Workers AI: Read' permissions
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token_here"

# Fast photorealistic text-to-image model identifier (Flux.1 Schnell)
AI_MODEL_ID="@cf/black-forest-labs/flux-1-schnell"

# ------------------------------------------------------------------------------
# 7. QUOTA & BILLING SAFEGUARDS
# ------------------------------------------------------------------------------
# Maximum monthly AI image generations permitted for this restaurant (Default: 30)
MONTHLY_AI_CREDITS="30"

